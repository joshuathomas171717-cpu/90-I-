# Copy to .env (which is gitignored) and fill in. Nothing here is required: the project runs
# entirely on the committed dataset with no account, no key and no network.
#
# Load it however you like, e.g.:
#     set -a && . ./.env && set +a && python3 update_week.py
# In CI, put these in repository secrets instead — never in the file.

# ── Optional: live results (P2.1) ────────────────────────────────────────────
# Free key by email: https://www.football-data.org/client/register
# Free tier: 10 requests/minute, 12 competitions, non-commercial, and it asks for a visible
# credit — the dashboard footer carries one. Without this the weekly job reads the local CSVs
# (or a JSON export in data/provider_drop/) instead, which is the documented fallback.
FOOTBALL_DATA_ORG_TOKEN=

# ── Optional: provider override ─────────────────────────────────────────────
# "auto" (default) = live when a token is set, local otherwise. Force one with:
# NT90_SOURCE=local
# NT90_SOURCE=football-data-org

# ── Optional: alerting (P4.5) ────────────────────────────────────────────────
# Slack or Discord incoming webhook. The weekly job posts here when it rejects a pull, crashes,
# or exits non-zero; NT90_ALERT_ON_SUCCESS=1 also posts a short "published gwN" digest.
NT90_ALERT_WEBHOOK=
NT90_ALERT_ON_SUCCESS=0

# ── Optional: server tuning (full list in DEPLOY.md §7) ──────────────────────
# PORT=8000
# NT90_PRELOAD=1
# NT90_SIM_CONCURRENCY=2
# NT90_RATE_BURST=30
# NT90_ACCESS_LOG=1
